# ============================================================
# Dragon 短剧流水线 — 环境变量模板
# 复制为 .env 并填入真实值：  cp .env.example .env
# ⚠️ .env 已在 .gitignore，不会被提交/覆盖
# ============================================================

# ── 核心 API Key（必填）──────────────────────────────────────
# andlapi.cn 统一 API Key（LLM + HappyHorse 视频生成一个 Key 全搞定）
# 获取：https://api.andlapi.cn
DRAGON_API_KEY=sk-你的API密钥

# ── 视频生成模型（可选，覆盖默认值）─────────────────────────
# 短剧铁律：只用 happyhorse，禁用 wan2.7
DRAMA_MODEL=deepseek-v4-pro          # 剧本/审阅用（推理模型）
# 分镜/结构化输出建议用 deepseek-v3.2（零推理开销）

# ── 飞书 / Lark（可选，需要飞书通道时才填）───────────────────
# 获取：https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_VERIFICATION_TOKEN=

# ── SignOSS 参考图上传（可选）────────────────────────────────
# 用于角色/场景参考图上传，返回 OSS 公网 URL 供 R2V 使用
SIGNOSS_API_KEY=sk-你的SignOSS密钥
SIGNOSS_BASE=https://api.andlapi.cn/signoss

# ── WebUI 端口（可选，默认 5000）─────────────────────────────
PORT=5000
