{
  "name": "dragon-tui",
  "version": "1.0.0",
  "description": "🐉 Dragon Agent — Ink React TUI Frontend",
  "type": "module",
  "main": "src/app.tsx",
  "scripts": {
    "start": "node --import tsx src/app.tsx",
