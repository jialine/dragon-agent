# Panda Agent — Environment Configuration Template
# Copy to .env:  cp .env.example .env

# ── Feishu / Lark ──
# Get from: https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_VERIFICATION_TOKEN=

# ── Provider API Keys (at least one required) ──
# OpenAI (GPT-4o, GPT-4o-mini)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek (V3, Reasoner)
# https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude Sonnet, Haiku)
# https://console.anthropic.com/keys
# ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google (Gemini 2.5)
# https://aistudio.google.com/apikey
# GOOGLE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# xAI (Grok-3)
# https://console.x.ai
# XAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Moonshot / Kimi (月之暗面)
# https://platform.moonshot.cn/console/api-keys
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Together AI
# https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq
# https://console.groq.com/keys
# GROQ_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral AI
# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere
# https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Perplexity
# https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fireworks AI
# https://fireworks.ai/account/api-keys
# FIREWORKS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Replicate
# https://replicate.com/account/api-tokens
# REPLICATE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Local ──
# OLLAMA_HOST=http://localhost:11434

# ── Cloud/Enterprise ──
# AZURE_OPENAI_API_KEY=xxx
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com
# VERTEX_PROJECT_ID=xxx
# AWS_ACCESS_KEY_ID=xxx
# AWS_REGION=us-east-1
# CLOUDFLARE_API_KEY=xxx
# CLOUDFLARE_ACCOUNT_ID=xxx

# ── Defaults ──
PANDA_DEFAULT_MODEL=gpt-4o
PANDA_DEFAULT_PROVIDER=openai
PANDA_SERVER_PORT=8000
