# Dragon Agent Configuration
# Copy to ~/.dragon/config.yaml and edit for your setup.

# ── Provider (Default model) ──────────────────────────────────
provider:
  default: "agilemind"            # agilemind / deepseek / openai / ...
  agilemind:
    model: "qwen3.5-122b-a10b"    # qwen3.5-122b-a10b / qwen3.6-35b-a3b
  # deepseek:
  #   model: "deepseek-chat"
  # openai:
  #   model: "gpt-4o"
#
# Environment variables:
#   AGILEMIND_API_KEY  — Your AgileMind API key (required)
#   AGILEMIND_API_URL  — API endpoint (default: https://api.agilemind.ai/v1)
#   Register at: https://console.agilemind.ai

# ── Router (本地小模型，行业分类) ────────────────────────────────
router:
  model_path: "models/qwen3-0.6b-q4_k_m.gguf"
  n_threads: 4
  n_ctx: 512
  temperature: 0.1
  max_tokens: 128
  fallback_on_failure: true

# ── Dispatch（行业 system_prompt，统一走 provider 的 API）─────────
dispatch:
  industries:
    finance:
      system_prompt: "你是金融行业专家，擅长风控分析、投资建议和合规审查。请用中文回答。"
    medical:
      system_prompt: "你是医疗行业专家，擅长诊断辅助、病历分析和药学咨询。请用中文回答。"
    legal:
      system_prompt: "你是法律行业专家，擅长合同审查、诉讼分析和法规解读。请用中文回答。"
    education:
      system_prompt: "你是教育行业专家，擅长教案设计、答疑辅导和学情评估。请用中文回答。"
    general:
      system_prompt: "你是一个乐于助人的 AI 助手。请用中文回答。"

# ── Memory（向量知识库）───────────────────────────────────────
memory:
  persist_dir: "dragon_data/vectordb"
  embedding_model: "BAAI/bge-small-zh-v1.5"
  search_top_k: 5
  search_threshold: 0.5
  recency_weight: 0.1

# ── Backup（云端备份）─────────────────────────────────────────
backup:
  endpoint: "https://oss-cn-shanghai.aliyuncs.com"
  access_key_env: "DRAGON_BACKUP_ACCESS_KEY"
  secret_key_env: "DRAGON_BACKUP_SECRET_KEY"
  bucket: "dragon-backups"
  prefix: "dragon/backups/"
  interval_hours: 6
  keep_last: 7

# ── Guard（反Loop保护）─────────────────────────────────────────
guard:
  max_consecutive_repeats: 3
  max_loop_rounds: 2
  max_ineffective_retries: 3
  window_size: 50
  task_timeout_secs: 300

# ── Server ───────────────────────────────────────────────────
server:
  host: "0.0.0.0"
  port: 8000
  log_level: "info"
